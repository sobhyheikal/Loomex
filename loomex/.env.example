# Copy this file to .env for local development, and set the same two
# values in Vercel → Project → Settings → Environment Variables for production.
#
# Get both from: Supabase dashboard → your project → Settings → API

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API → "service_role" secret key (NOT the "anon" public key).
# This key bypasses Row Level Security, so treat it like a password:
# never commit it, never put it in frontend code.
SUPABASE_SERVICE_KEY=your-service-role-key-here
